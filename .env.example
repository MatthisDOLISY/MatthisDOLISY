# Copiez ce fichier en .env et renseignez UNE des options ci-dessous
# pour activer l'assistant LLM. (Toutes les analyses/exports marchent sans clé.)
#
# L'app utilise la première option dont la clé est présente, dans cet ordre :
# Groq (gratuit) -> OpenAI-compatible -> Ollama (local) -> Anthropic.

# === OPTION 1 (recommandée, GRATUITE, sans carte bancaire) : Groq ===
# Créez une clé sur https://console.groq.com/keys  puis collez-la ci-dessous.
GROQ_API_KEY=gsk_votre_cle_groq
# Optionnel : modèle Groq (défaut : llama-3.3-70b-versatile)
#GROQ_MODEL=llama-3.3-70b-versatile

# === OPTION 2 : OpenAI ou tout endpoint compatible (Gemini, OpenRouter…) ===
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini
# Exemple Google Gemini (gratuit) :
#OPENAI_API_KEY=votre_cle_gemini
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#OPENAI_MODEL=gemini-2.0-flash

# === OPTION 3 : Ollama en local (100% gratuit, hors ligne) ===
# Installez https://ollama.com puis : ollama pull llama3.1
#OLLAMA_MODEL=llama3.1

# === OPTION 4 : Anthropic (Claude) — payant ===
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-opus-4-8

# Optionnel : port du serveur API (défaut : 8787)
#PORT=8787
